{
    "socket.url": "ws://127.0.0.1:3000",
    "asset.url": "http://127.0.0.1:3000/assets",
    "image.library.url": "http://127.0.0.1:3000/assets/c_images/",
    "hof.furni.url": "http://127.0.0.1:3000/assets/furniture",
    "images.url": "${asset.url}/images",
